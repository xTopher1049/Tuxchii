diff --git a/src/video_core/engines/engine_interface.h b/src/video_core/engines/engine_interface.h
index da7ee6d..05d1d5a 100644
--- a/src/video_core/engines/engine_interface.h
+++ b/src/video_core/engines/engine_interface.h
@@ -7,6 +7,7 @@
 
 #include <bitset>
 #include <limits>
+#include <type_traits>
 #include <vector>
 
 #include "common/common_types.h"
@@ -30,6 +31,13 @@ class EngineInterface {
 public:
     virtual ~EngineInterface() = default;
 
+    /// Linux build patch: which engine this is. Fritchii v6 tells the engines apart with
+    /// dynamic_cast, which needs RTTI; GCC and Clang builds use -fno-rtti (src/CMakeLists.txt).
+    /// EngineCast below does the same check with this instead.
+    [[nodiscard]] virtual EngineTypes EngineType() const noexcept {
+        return EngineTypes::Nv01Timer;
+    }
+
     /// Write the value to the register identified by method.
     virtual void CallMethod(Core::System& system, u32 method, u32 method_argument, bool is_last_call) = 0;
 
@@ -91,4 +99,13 @@ protected:
     }
 };
 
+/// Linux build patch: dynamic_cast<T*>(engine) without RTTI, for the engine classes that report
+/// their type (all of them are final, so the type alone decides).
+template <typename T, typename E>
+[[nodiscard]] T* EngineCast(E* engine) noexcept {
+    return engine != nullptr && engine->EngineType() == std::remove_cv_t<T>::engine_type_value
+               ? static_cast<T*>(engine)
+               : nullptr;
+}
+
 } // namespace Tegra::Engines
